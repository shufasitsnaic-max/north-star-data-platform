# Example environment for the North Star platform.
# Copy to `.env` (gitignored) and adjust as needed. Compose reads `.env`
# automatically; these mirror the defaults baked into docker-compose.yml.

# --- Kafka ---
# In-network address used by services (the host uses localhost:9092 instead).
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=tlc-raw-events

# --- Simulator replay controls ---
# Where the fetched parquet lives inside the container (host ./data is mounted to /data).
DATA_DIR=/data/raw
# Cap the number of records replayed (0 = all).
MAX_ROWS=5000
# Seconds to wait between records (0 = as fast as possible).
SLEEP=0
# Optional: begin replay at this pickup time — this is the ML train/replay cutoff.
# START_DATETIME=2024-01-01T00:00:00
# Optional: restrict which monthly files load.
# START_MONTH=2024-01
# END_MONTH=2024-03

# --- Cold-path backfill scope ---
# Which months cold_path_backfill loads into the lake, inclusive. Must be at or
# before the cutoff. Trim this rather than editing the DAG: the lake runs about
# 200MB per month, and disk is the binding constraint on a codespace.
BACKFILL_START=2023-01
BACKFILL_END=2025-12

# --- ML ---
# Rows sampled from the lake for training, stratified across months.
TRAIN_SAMPLE_ROWS=1500000
