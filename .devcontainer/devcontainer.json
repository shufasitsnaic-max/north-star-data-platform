// Dev container for the North Star data platform.
//
// Purpose: give the project a Linux host with a working Docker daemon. The
// primary dev machine is Windows 11 *Home*, where Docker Desktop supports only
// the WSL 2 backend (the Hyper-V backend is Pro/Enterprise-only) and WSL 2
// cannot be installed there — see docs/DECISIONS.md, 2026-08-16.
//
// Open with: GitHub > Code > Codespaces > "Create codespace on master".
// This file is equally valid for VS Code "Dev Containers: Reopen in Container"
// on any machine that already has a working Docker daemon.
{
  "name": "north-star-data-platform",

  // Python 3.11 to match the gateway/simulator images (python:3.11-slim), so
  // anything run directly in the container (e.g. data_fetcher) behaves the same
  // as it does inside a service image.
  //
  // Built from a local Dockerfile rather than referenced with "image" only
  // because the upstream image has a broken Yarn apt source that breaks feature
  // installs — see the comments in ./Dockerfile.
  "build": {
    "dockerfile": "Dockerfile"
  },

  "features": {
    // A Docker daemon INSIDE this container, not the host's socket.
    //
    // Deliberate: with docker-outside-of-docker, Compose bind mounts resolve
    // against the *daemon's* filesystem. The simulator's `./data:/data:ro`
    // mount would then point at a path that does not exist, and the replay
    // would start against an empty directory. Running the daemon in here keeps
    // the workspace and the daemon on the same filesystem.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "dockerDashComposeVersion": "v2"
    }

    // No java feature here on purpose — the JDK is installed in ./Dockerfile
    // instead. ghcr.io/devcontainers/features/java was tried and left
    // `java: command not found`; see the comment in that file for why, and why
    // apt's openjdk is the more reliable route in this container.
  },

  // Ports for the phases that exist today. Later phases add their own
  // (Airflow 8080 arrives with P4 step 5, Streamlit 8501 in P6) — not
  // pre-declared here, per the no-scaffolding-ahead rule in CLAUDE.md.
  "forwardPorts": [8000, 9092, 5432, 8081, 8080],
  "portsAttributes": {
    "8000": { "label": "gateway (FastAPI)", "onAutoForward": "notify" },
    "9092": { "label": "kafka (host listener)", "onAutoForward": "silent" },
    "5432": { "label": "postgres (hot-path metrics)", "onAutoForward": "silent" },
    // Spark's master UI is on 8081, not its usual 8080, which Airflow claims.
    // Useful during a backfill: it shows whether the job actually reached the
    // cluster or is quietly running in the driver's local mode.
    "8081": { "label": "spark master UI", "onAutoForward": "notify" },
    // Airflow's webserver. Log in with admin/admin — development credentials,
    // created by airflow-init and never used anywhere real.
    "8080": { "label": "airflow (webserver)", "onAutoForward": "notify" }
  },

  // uv is the per-component dependency manager for this repo (no
  // requirements.txt, no shared env). Pinned to the same version the service
  // Dockerfiles copy in, so uv.lock is read by one uv version project-wide.
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/0.5.11/install.sh | sh",

  // The uv installer drops the binary in ~/.local/bin.
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/.local/bin"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker"
      ]
    }
  },

  // Machine size: this project now needs 4-core / 16 GB (standardLinux32gb),
  // set via the Codespaces "Change machine type" menu — it is a per-codespace
  // setting, not something this file can pin. The default 2-core / 8 GB carried
  // Phases 1-3 but not Phase 4: Kafka, Postgres, the gateway, the hot path, a
  // Spark master and worker, and three Airflow containers come to roughly
  // 10.5 GB resident. Note a 4-core machine burns included core-hours at twice
  // the rate, so stop the codespace when you are done for the day.
  "remoteUser": "vscode"
}